{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaQC",
  "version": "0.0.0",
  "identifier": "com.mediaqc.desktop",
  "build": {
    "beforeBuildCommand": "npm run build --workspace @mediaqc/frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaQC",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
